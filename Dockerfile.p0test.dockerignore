.idea/
.vscode/
*.swp

# Git / CI
.git/
.gitignore
.github/

# 其他 Dockerfile 防递归
docker-compose.yml
Dockerfile
Dockerfile.local

# 文档
README.md
docs/

# OS
.DS_Store
Thumbs.db
