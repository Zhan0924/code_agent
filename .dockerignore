# Build artifacts
# bin/ — NOT excluded: Dockerfile.local needs bin/code-agent-linux
coverage.out

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# CI/CD
.github/

# Docker (prevent recursive context)
docker-compose.yml
Dockerfile

