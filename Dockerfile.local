# ============================================================
# Local build Dockerfile - uses pre-compiled static binary
# Usage: 
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o bin/code-agent-linux ./cmd/agent
#   docker tag docker.1ms.run/alpine:latest alpine:local  (one-time)
#   docker build --network=none -f Dockerfile.local -t code-agent:test .
# ============================================================
FROM alpine:local

# Static binary needs no extra packages. Skip apk to avoid network.
# ca-certificates are already in alpine base image.

COPY bin/code-agent-linux /usr/local/bin/code-agent
# Copy only the example config — real config.yaml is provided at runtime via
# bind mount (see docker-compose.yml). This prevents secrets being baked in.
COPY configs/config.example.yaml /etc/code-agent/configs/config.example.yaml

EXPOSE 8080 8081

# Use wget (built into alpine) instead of curl for healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/healthz || exit 1

ENTRYPOINT ["code-agent"]
CMD ["--config", "/etc/code-agent/configs/config.yaml"]
